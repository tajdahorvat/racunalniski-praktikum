Cell[TextData[{
 "Matemati\[CHacek]ne izraze pi\[SHacek]emo podobno, kot smo to \
po\[CHacek]eli v ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"L", 
